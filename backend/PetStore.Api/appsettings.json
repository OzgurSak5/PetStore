{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OrderSettings": {
    "ReservationMinutes": 15,
    "ReservationCheckIntervalSeconds": 60
  },
