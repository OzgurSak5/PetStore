{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OrderSettings": {
    "ReservationMinutes": 15,
    "ReservationCheckIntervalSeconds": 60
  },
  "FileStorageSettings": {
    "UploadPath": "uploads/pets",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "BaseUrl": "http://localhost:5087"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "PetStoreApi",
    "Audience": "PetStoreApiUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimit": {
    "IpPermitLimit": 20,
    "IpWindowMinutes": 5,
    "EmailPermitLimit": 5,
    "EmailWindowMinutes": 5
  },
  "AllowedHosts": "*"
}